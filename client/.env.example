# Timeouts in ms, read at build time. A slower lazy page or MFE shows its fallback; a slower API
# call fails.
VITE_LAZY_CHUNK_TIMEOUT_MS=5000
VITE_API_TIMEOUT_MS=4000
VITE_MFE_LOAD_TIMEOUT_MS=5000
VITE_MFE_MOUNT_TIMEOUT_MS=3000

# New Relic browser app (Pro+SPA). These are placeholders until the browser app is set up; they
# are public keys, and only VITE_ variables reach the browser.
VITE_NEW_RELIC_ACCOUNT_ID=0000000
VITE_NEW_RELIC_TRUST_KEY=0000000
VITE_NEW_RELIC_AGENT_ID=0000000000
VITE_NEW_RELIC_LICENSE_KEY=dummy-new-relic-browser-key
VITE_NEW_RELIC_APPLICATION_ID=0000000000

# Source map upload at build time. Not a VITE_ variable, so it never reaches the browser.
NEW_RELIC_USER_API_KEY=dummy-new-relic-user-api-key
# The public origin the maps are uploaded against: the router locally, the CDN in production.
PUBLIC_ORIGIN=http://localhost:3000
