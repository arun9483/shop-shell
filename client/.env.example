# Timeouts in ms, read at build time. A slower lazy page or MFE shows its fallback; a slower API
# call fails.
VITE_LAZY_CHUNK_TIMEOUT_MS=5000
VITE_API_TIMEOUT_MS=4000
VITE_MFE_LOAD_TIMEOUT_MS=5000
VITE_MFE_MOUNT_TIMEOUT_MS=3000

# The New Relic browser agent's values are read at runtime from the page (fes/.env, PUBLIC_NEW_RELIC_*),
# so one build serves every tenant.

# Source map upload (deploy/upload-sourcemaps.sh, once per tenant), never sent to the browser: the
# tenant's browser application and the public origin the maps are uploaded against.
NEW_RELIC_USER_API_KEY=dummy-new-relic-user-api-key
NEW_RELIC_BROWSER_APP_ID=0000000000
PUBLIC_ORIGIN=http://localhost:3000
