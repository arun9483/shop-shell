PORT=3001
BACKEND_URL=http://localhost:4001
# A backend call slower than this is answered with 504.
BACKEND_TIMEOUT_MS=3000
CLIENT_DIST=../client/dist

# New Relic Node agent. The license key is a placeholder until the New Relic account is set up.
NEW_RELIC_ENABLED=true
NEW_RELIC_LICENSE_KEY=dummy-new-relic-license-key
NEW_RELIC_APP_NAME=shell-fes
NEW_RELIC_NO_CONFIG_FILE=true
NEW_RELIC_LOG=stdout
NEW_RELIC_LOG_LEVEL=warn
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
# Health and version checks and static files are left out of New Relic transactions.
NEW_RELIC_IGNORING_RULES=^/health/,^/version$,^/assets/
# Keep the whole trace when the caller (the browser or an FES) kept it.
NEW_RELIC_DISTRIBUTED_TRACING_SAMPLER_REMOTE_PARENT_SAMPLED=always_on
# Local only: skip the agent's cloud host checks, which fail off-cloud and log errors at start.
NEW_RELIC_UTILIZATION_DETECT_AWS=false
NEW_RELIC_UTILIZATION_DETECT_AZURE=false
NEW_RELIC_UTILIZATION_DETECT_GCP=false

# Sign-in (MVP-2), off unless AUTH_ENABLED=true. shop-mfe-platform's compose.sso.yaml turns it on with
# AUTH_ENABLED, OIDC_ISSUER_URL, OIDC_INTERNAL_URL and PUBLIC_ORIGIN; these stay here.
# The Shell FES signs users in as shell-fes. OIDC_CLIENT_SECRET is this server's copy of
# SHELL_FES_SECRET in keycloak/.env: the two must match.
OIDC_CLIENT_ID=shell-fes
OIDC_CLIENT_SECRET=change-me
# Encrypts the refresh-token and ID-token cookies: 64 random hex characters (openssl rand -hex 32).
AUTH_COOKIE_KEY=change-me
