PORT=4001

# New Relic Node agent. The license key is a placeholder until the New Relic account is set up.
NEW_RELIC_ENABLED=true
NEW_RELIC_LICENSE_KEY=dummy-new-relic-license-key
NEW_RELIC_APP_NAME=shell-backend
NEW_RELIC_NO_CONFIG_FILE=true
NEW_RELIC_LOG=stdout
NEW_RELIC_LOG_LEVEL=warn
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
# Health and version checks are left out of New Relic transactions.
NEW_RELIC_IGNORING_RULES=^/health/,^/version$
