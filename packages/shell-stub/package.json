    "@arun-dev/tokens": "catalog:",
    "@arun-dev/ui": "catalog:",
    "@newrelic/browser-agent": "catalog:",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "single-spa": "catalog:",
    "supertest": "7.3.1",
    "vite": "8.3.5"
  }
}
